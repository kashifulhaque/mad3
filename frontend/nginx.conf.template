# nginx settings for the production frontend (see Dockerfile.prod).
server {
    listen 80;
    root /usr/share/nginx/html;

    # Forward API calls to the Flask backend container.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # vue-router uses clean URLs such as /students. Those aren't real files,
    # so nginx sends index.html for them and the router picks the page.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
